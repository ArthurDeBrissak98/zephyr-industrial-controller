mainmenu "Industrial controller"

config USE_HW_IO
    bool "Use hardware ADC inputs"
    select ADC
    default n
    help
      Exclusive ownership of the ADC device is required. Define two
      io-channels in zephyr,user: current loop and voltage input.

config APP_SIMULATED_IO
    bool
    default y if !USE_HW_IO

config APP_SETTINGS
    bool "Controller settings in NVS"
    depends on SETTINGS_NVS
    select CRC
    default n

config APP_WATCHDOG
    bool "Hardware watchdog for the polling thread"
    depends on WATCHDOG
    default n
    help
      Requires an enabled watchdog0 devicetree alias. Feed only after a
      completed polling cycle; crash_test suspends that thread for testing.

config APP_MODBUS
    bool "Controller Modbus RTU server"
    depends on MODBUS_SERIAL && MODBUS_SERVER
    default n

source "Kconfig.zephyr"
