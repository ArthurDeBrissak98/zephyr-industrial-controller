mainmenu "Industrial controller"

config APP_SIMULATED_IO
    bool "Simulated sensors and drive"
    default y

config APP_SETTINGS
    bool "Controller settings in NVS"
    depends on SETTINGS_NVS
    select CRC
    default n

config APP_WATCHDOG
    bool "Hardware watchdog for the polling thread"
    depends on WATCHDOG
    default n
    help
      Requires an enabled watchdog0 devicetree alias. Feed only after a
      completed polling cycle; crash_test suspends that thread for testing.

source "Kconfig.zephyr"
