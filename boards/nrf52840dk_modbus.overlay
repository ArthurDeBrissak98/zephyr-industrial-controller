#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {
    controller_uart1_default: controller_uart1_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 1)>, <NRF_PSEL(UART_RX, 1, 2)>;
        };
    };
    controller_uart1_sleep: controller_uart1_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 1)>, <NRF_PSEL(UART_RX, 1, 2)>;
            low-power-enable;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <19200>;
    pinctrl-0 = <&controller_uart1_default>;
    pinctrl-1 = <&controller_uart1_sleep>;
    pinctrl-names = "default", "sleep";
    controller_modbus: modbus {
        compatible = "zephyr,modbus-serial";
        status = "okay";
        /* GPIO управления RS-485 добавляются под выбранный трансивер. */
    };
};
