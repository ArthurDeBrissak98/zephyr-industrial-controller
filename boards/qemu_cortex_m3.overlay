#include "settings_flash.overlay"

/* UART1 в QEMU реализован моделью PL011. Нужна настройка формата RTU. */
&uart1 {
    compatible = "arm,pl011";
    reg = <0x4000d000 0x1000>;
    clock-frequency = <12000000>;
    current-speed = <19200>;
    interrupt-names = "irq";
    status = "okay";
    controller_modbus: modbus {
        compatible = "zephyr,modbus-serial";
        status = "okay";
    };
};
