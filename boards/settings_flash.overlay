#include <mem.h>

/ {
    chosen {
        zephyr,settings-partition = &controller_storage;
    };
    settings_flash_controller {
        compatible = "zephyr,semihost-flash";
        filename = "controller_flash.bin";
        #address-cells = <1>;
        #size-cells = <1>;
        settings_flash: flash@0 {
            compatible = "soc-nv-flash";
            reg = <0 DT_SIZE_K(16)>;
            erase-block-size = <4096>;
            write-block-size = <1>;
            partitions {
                compatible = "fixed-partitions";
                #address-cells = <1>;
                #size-cells = <1>;
                controller_storage: partition@0 {
                    label = "controller-settings";
                    reg = <0 DT_SIZE_K(16)>;
                };
            };
        };
    };
};
